<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Vida &amp; Saúde</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topo">
    <a class="marca" href="/">Clínica Vida &amp; Saúde</a>
    <nav>
      <% if (usuario) { %>
        <a href="/consultas">Consultas</a>
        <a href="/pacientes">Pacientes</a>
        <a href="/medicos">Médicos</a>
        <span class="ola">Olá, <strong><%= usuario.nome %></strong></span>
        <form method="post" action="/logout" class="inline">
          <button class="link-sair" type="submit">Sair</button>
        </form>
      <% } else { %>
        <a href="/login">Entrar</a>
      <% } %>
    </nav>
  </header>
  <main class="conteudo">
    <% if (flash) { %>
      <div class="aviso aviso-<%= flash.tipo %>"><%= flash.texto %></div>
    <% } %>
