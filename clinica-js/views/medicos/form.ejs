<%- include('../partials/header') %>

<div class="cartao cartao-form">
  <div class="cartao-topo"><h1><%= title %></h1></div>
  <form method="post" action="<%= acao %>" class="cartao-corpo">
    <% if (erro) { %><div class="aviso aviso-erro"><%= erro %></div><% } %>

    <label for="nome">Nome</label>
    <input id="nome" name="nome" maxlength="100" value="<%= medico.Nome || '' %>" required>

    <label for="crm">CRM</label>
    <input id="crm" name="crm" maxlength="20" placeholder="CRM/SP 123456" value="<%= medico.Crm || '' %>" required>

    <label for="especialidade">Especialidade</label>
    <input id="especialidade" name="especialidade" maxlength="50" placeholder="Cardiologia" value="<%= medico.Especialidade || '' %>" required>

    <div class="botoes">
      <button class="btn btn-primario" type="submit">Salvar</button>
      <a class="btn" href="/medicos">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
