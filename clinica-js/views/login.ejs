<%- include('partials/header') %>

<div class="cartao cartao-login">
  <div class="cartao-topo">
    <h1>Clínica Vida &amp; Saúde</h1>
    <small>Acesso do Paciente</small>
  </div>
  <form method="post" action="/login" class="cartao-corpo">
    <% if (erro) { %><div class="aviso aviso-erro"><%= erro %></div><% } %>
    <label for="cpf">CPF do Paciente</label>
    <input id="cpf" name="cpf" value="<%= cpf %>" placeholder="Digite seu CPF (ex: 111.222.333-44)" inputmode="numeric" autocomplete="off" required>
    <button class="btn btn-primario" type="submit">Entrar</button>
  </form>
  <div class="cartao-rodape">
    <p>Ainda não tem cadastro?</p>
    <a href="/cadastro">Cadastre-se aqui</a>
  </div>
</div>

<%- include('partials/footer') %>
